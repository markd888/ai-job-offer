// Read-only cloud copy of the dashboard. Build with scripts/build_cloud.sh, which
// fills .cloud/ with the SPA and the data snapshot, then `npx wrangler deploy`.
//
// Access: enable Cloudflare Access on the workers.dev URL (Worker → Settings →
// Domains & Routes → Enable Cloudflare Access), then give the Worker the two
// values it checks every token against — once; secrets survive deploys:
//   npx wrangler secret put ACCESS_TEAM_DOMAIN   # https://<team>.cloudflareaccess.com
//   npx wrangler secret put ACCESS_AUD           # the Access application's AUD tag
// Until both are set the Worker serves nothing (503). See worker/index.js.
{
  "name": "job-search-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker's Access check — including the SPA
    // and the raw /data/*.json snapshots, which would otherwise be served
    // straight from the asset store.
    "run_worker_first": true
  }
}
